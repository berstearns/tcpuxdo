# tcpuxdo config — copy to .env and fill in. .env is git-ignored; never commit it.
# The Python engine is tcpux, so the variables keep their native TCPUX_* names.
#
#   cp .env.example .env
#
# ── REQUIRED ────────────────────────────────────────────────────────────────
# Public host (IP or DNS) of your relay VPS. main and the nodes both dial this.
TCPUX_HOST=

# TCP port the queue listens on (submit + poll). Pick an unused high port.
TCPUX_PORT=
# TCP port the allowlist admin server listens on.
TCPUX_ADMIN_PORT=

# Shared admin token gating allowlist mutations (allow/block). Generate with:
#   openssl rand -hex 32
TCPUX_ADMIN_TOKEN=

# ── OPTIONAL (sane defaults shown; uncomment to override) ────────────────────
# Live allowlist + shortcuts DBs on the relay (seeded from allowlist.seed.json).
#TCPUX_ALLOWLIST_DB=/srv/tcpuxdo/allowlist.json
#TCPUX_SHORTCUTS_DB=/srv/tcpuxdo/shortcuts.json

# Worker tuning (per node).
#TCPUX_WORKER=                # worker name; default = hostname. MUST be unique per node.
#TCPUX_POLL=2                 # seconds between queue polls
#TCPUX_SYNC=5                 # seconds between pane-state reports
# Pane commands treated as idle/safe-to-type-into. Note: includes `claude`.
#TCPUX_IDLE_CMDS=bash,zsh,fish,sh,dash,tcsh,ksh,claude

# ── OPTIONAL: relay/node deploy (only for the scripts under setup/) ──────────
# SSH user for the relay VPS (default root).
#TCPUX_VPS_USER=root
# Install root on the relay.
#REMOTE_ROOT=/srv/tcpuxdo
# DO cloud firewall id fronting the relay — used by setup/02-open-ports.sh.
# Find it with: doctl compute firewall list
#TCPUX_DO_FW_ID=

# Per-node onboarding (consumed by setup/03-node-onboard.sh):
#NODE_SSH=user@nodeA          # ssh target of the tty node to onboard
#NODE_ROOT=/home/claude/tcpuxdo   # install dir on the node
#RUN_USER=claude              # non-root user the worker (and Claude Code) run as

# Canonical tmux session/window/pane TITLES (addressable, stable across deploys).
#QUEUE_SESSION=tcpuxdo-queue
#QUEUE_WINDOW=queue
#QUEUE_PANE_SERVER=tcpuxdo-queue-server
#QUEUE_PANE_ADMIN=tcpuxdo-queue-admin
#QUEUE_PANE_STATE=tcpuxdo-queue-state
#WORKER_SESSION=tcpuxdo-worker
#WORKER_WINDOW=worker
#WORKER_PANE_MAIN=tcpuxdo-worker-main
#WORKER_PANE_OBS=tcpuxdo-worker-obs
